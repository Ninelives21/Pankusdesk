{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pankusdesk.local/schemas/subject.schema.json",
  "$comment": "Design Lock v2 subject metadata and generic source/practice renderer configuration.",
  "title": "PankusDesk College Subject — Design Lock v2",
  "type": "object",
  "additionalProperties": true,
  "required": ["code", "name", "shortName", "regulation", "semester", "kb", "syllabus", "coverage", "units"],
  "properties": {
    "code": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "shortName": {"type": "string", "minLength": 1},
    "regulation": {"type": "string", "minLength": 1},
    "semester": {"type": "string", "pattern": "^[0-9]+-[0-9]+$"},
    "credits": {"type": ["number", "integer"]},
    "kb": {"type": "string", "minLength": 1},
    "syllabus": {"type": "string", "minLength": 1},
    "coverage": {"type": "string", "minLength": 1},
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["number", "title", "publicationStatus"],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1},
          "notes": {"type": "string"},
          "publicationStatus": {"enum": ["ready", "scaffold"]}
        }
      }
    },
    "pyqStatus": {"type": "string"},
    "unitRenderer": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "syllabusPage": {"type": "string"},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["path", "idField", "kind", "format"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "collection": {"type": "string"},
              "idField": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "minLength": 1},
              "format": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "practice": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "unitQuestions": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "label": {"type": "string"},
            "description": {"type": "string"},
            "hrefPattern": {"type": "string"},
            "availableUnits": {
              "type": "array",
              "items": {"type": "integer", "minimum": 1},
              "uniqueItems": true
            },
            "data": {"type": "string"}
          }
        },
        "pyqs": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "label": {"type": "string"},
            "description": {"type": "string"},
            "href": {"type": "string"},
            "status": {"type": "string"}
          }
        }
      }
    }
  }
}
