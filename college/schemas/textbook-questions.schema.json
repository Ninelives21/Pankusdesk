{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pankusdesk.local/schemas/textbook-questions.schema.json",
  "title": "PankusDesk Prescribed Textbook Questions",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "subject_code", "source", "units"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "subject_code": {"type": "string", "minLength": 1},
    "source": {"type": "object", "required": ["type", "title"], "additionalProperties": true},
    "units": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/unitQuestions"}
    }
  },
  "$defs": {
    "figure": {
      "type": "object",
      "additionalProperties": true,
      "required": ["src", "alt"],
      "properties": {
        "src": {"type": "string", "minLength": 1},
        "alt": {"type": "string", "minLength": 8},
        "caption": {"type": "string"},
        "page": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headers", "rows"],
      "properties": {
        "headers": {"type": "array", "items": {"type": "string"}},
        "rows": {
          "type": "array",
          "items": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {"type": "string"},
        "paragraphs": {"type": "array", "items": {"type": "string"}},
        "paragraphs_after": {"type": "array", "items": {"type": "string"}},
        "bullets": {"type": "array", "items": {"type": "string"}},
        "equations": {"type": "array", "items": {"type": "string"}},
        "steps": {"type": "array", "items": {"type": "string"}},
        "result": {"type": "string"},
        "note": {"type": "string"},
        "book_check": {"type": "string"},
        "diagram": {"type": "string"},
        "table": {"$ref": "#/$defs/table"},
        "figures": {"type": "array", "items": {"$ref": "#/$defs/figure"}}
      },
      "minProperties": 1
    },
    "question": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "number", "book_page", "question", "answer"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "number": {"type": "integer", "minimum": 1},
        "book_page": {"type": "integer", "minimum": 1},
        "topic_id": {"type": "string"},
        "question": {"type": "string", "minLength": 1},
        "r25_scope": {"type": "string"},
        "answer": {"$ref": "#/$defs/answer"},
        "answer_basis": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "answer_source_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "questions"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}}
      }
    },
    "unitQuestions": {
      "type": "object",
      "additionalProperties": true,
      "required": ["title", "groups"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "object", "additionalProperties": true},
        "scope_note": {"type": "string"},
        "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
        "source": {"type": "object", "additionalProperties": true}
      }
    }
  }
}
