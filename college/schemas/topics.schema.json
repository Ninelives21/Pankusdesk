{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pankusdesk.local/schemas/topics.schema.json",
  "$comment": "Design Lock v2: cumulative topics, class-note panels, explanation accordions and explicit Grid/anchor figure placement.",
  "title": "PankusDesk Cumulative Topics — Design Lock v2",
  "type": "array",
  "items": {
    "$ref": "#/$defs/topic"
  },
  "$defs": {
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "bookRef": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "pages"
      ],
      "properties": {
        "pages": {
          "type": "string",
          "minLength": 1
        },
        "images": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "afterPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "before-paragraph",
            "paragraph",
            "bullet",
            "end"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "end"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {},
          "else": {
            "required": [
              "index"
            ]
          }
        }
      ]
    },
    "gridPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "side": {
          "enum": [
            "left",
            "right"
          ]
        },
        "size": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "src",
        "alt"
      ],
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string",
          "minLength": 8
        },
        "caption": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "size": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "$ref": "#/$defs/afterPlacement"
        },
        "grid": {
          "$ref": "#/$defs/gridPlacement"
        }
      },
      "not": {
        "required": [
          "after",
          "grid"
        ]
      }
    },
    "studyTable": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "headers",
        "rows"
      ],
      "properties": {
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "headers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "type",
                    "src",
                    "alt"
                  ],
                  "properties": {
                    "type": {
                      "const": "image"
                    },
                    "src": {
                      "type": "string",
                      "minLength": 1
                    },
                    "alt": {
                      "type": "string",
                      "minLength": 8
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "size": {
                      "type": "string",
                      "enum": [
                        "symbol",
                        "small",
                        "medium",
                        "large"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "accordion": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bullets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "final_answer": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "paragraphs"
          ]
        },
        {
          "required": [
            "bullets"
          ]
        }
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "heading",
        "scope",
        "source_refs"
      ],
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "core",
            "supporting",
            "core-gap-filled"
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "source_label": {
          "type": "string",
          "minLength": 1
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bullets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/studyTable"
          }
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "book_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bookRef"
          }
        },
        "figures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/figure"
          }
        },
        "accordions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/accordion"
          }
        },
        "accordion_recap": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "practice": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/practice"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "class-note"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "source_label"
            ]
          }
        }
      ],
      "anyOf": [
        {
          "required": [
            "paragraphs"
          ]
        },
        {
          "required": [
            "bullets"
          ]
        },
        {
          "required": [
            "tables"
          ]
        },
        {
          "required": [
            "figures"
          ]
        },
        {
          "required": [
            "accordions"
          ]
        }
      ]
    },
    "practice": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "book_page",
        "type",
        "items"
      ],
      "properties": {
        "book_page": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "group_anchor": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "selfCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "answer"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "classHistory": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "date",
        "label",
        "href"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "unit",
        "title",
        "status",
        "learn",
        "formulas",
        "method",
        "source_refs",
        "book_refs",
        "cautions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^u[0-9]+-[a-z0-9][a-z0-9-]*$"
        },
        "unit": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "core",
            "supporting",
            "core-gap-filled"
          ]
        },
        "intro": {
          "type": "string"
        },
        "learn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "formulas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "book_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bookRef"
          }
        },
        "cautions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "practice": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/practice"
          }
        },
        "self_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selfCheck"
          }
        },
        "class_history": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/classHistory"
          }
        }
      }
    }
  }
}
