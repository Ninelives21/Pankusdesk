{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pankusdesk.local/schemas/topics.schema.json",
  "title": "PankusDesk Cumulative Topics",
  "type": "array",
  "items": {"$ref": "#/$defs/topic"},
  "$defs": {
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "bookRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["pages"],
      "properties": {
        "pages": {"type": "string", "minLength": 1},
        "images": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": true,
      "required": ["src", "alt"],
      "properties": {
        "src": {"type": "string", "minLength": 1},
        "alt": {"type": "string", "minLength": 8},
        "caption": {"type": "string"},
        "page": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "kind": {"type": "string"},
        "after": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "index"],
          "properties": {
            "type": {"enum": ["paragraph", "bullet", "end"]},
            "index": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": true,
      "required": ["heading", "scope", "source_refs"],
      "properties": {
        "heading": {"type": "string", "minLength": 1},
        "scope": {"enum": ["core", "supporting", "core-gap-filled"]},
        "paragraphs": {"type": "array", "items": {"type": "string"}},
        "bullets": {"type": "array", "items": {"type": "string"}},
        "source_refs": {"$ref": "#/$defs/sourceRefs"},
        "book_refs": {"type": "array", "items": {"$ref": "#/$defs/bookRef"}},
        "figures": {"type": "array", "items": {"$ref": "#/$defs/figure"}}
      },
      "anyOf": [
        {"required": ["paragraphs"]},
        {"required": ["bullets"]},
        {"required": ["figures"]}
      ]
    },
    "practice": {
      "type": "object",
      "additionalProperties": true,
      "required": ["book_page", "type", "items"],
      "properties": {
        "book_page": {"type": "integer", "minimum": 1},
        "type": {"type": "string", "minLength": 1},
        "items": {"type": "string", "minLength": 1},
        "anchor": {"type": "string", "minLength": 1}
      }
    },
    "selfCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer"],
      "properties": {
        "question": {"type": "string", "minLength": 1},
        "answer": {"type": "string", "minLength": 1}
      }
    },
    "classHistory": {
      "type": "object",
      "additionalProperties": true,
      "required": ["date", "label", "href"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "label": {"type": "string", "minLength": 1},
        "href": {"type": "string", "minLength": 1}
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "unit", "title", "status", "learn", "formulas", "method", "source_refs", "book_refs", "cautions"],
      "properties": {
        "id": {"type": "string", "pattern": "^u[0-9]+-[a-z0-9][a-z0-9-]*$"},
        "unit": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["core", "supporting", "core-gap-filled"]},
        "intro": {"type": "string"},
        "learn": {"type": "array", "items": {"type": "string"}},
        "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}},
        "formulas": {"type": "array", "items": {"type": "string"}},
        "method": {"type": "array", "items": {"type": "string"}},
        "source_refs": {"$ref": "#/$defs/sourceRefs"},
        "book_refs": {"type": "array", "items": {"$ref": "#/$defs/bookRef"}},
        "cautions": {"type": "array", "items": {"type": "string"}},
        "practice": {"type": "array", "items": {"$ref": "#/$defs/practice"}},
        "self_checks": {"type": "array", "items": {"$ref": "#/$defs/selfCheck"}},
        "class_history": {"type": "array", "items": {"$ref": "#/$defs/classHistory"}}
      }
    }
  }
}
