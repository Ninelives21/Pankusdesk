{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "College worksheet",
  "type": "object",
  "required": [
    "id",
    "label",
    "title",
    "source",
    "groups"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "href",
        "sha256",
        "note"
      ]
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "unit",
          "title",
          "source_pages",
          "questions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "unit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "title": {
            "type": "string"
          },
          "source_pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "number",
                "question_paragraphs",
                "paragraphs",
                "final_answer"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "question_paragraphs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "paragraphs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "final_answer": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
