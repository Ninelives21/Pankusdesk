{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pankusdesk.local/schemas/undated-class-notes.schema.json",
  "$comment": "Separate packet schema; no invented calendar dates.",
  "title": "PankusDesk Undated Class Notes",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "source_id",
    "subject",
    "unit",
    "title",
    "summary",
    "transcription_policy",
    "mapped_topics",
    "pages",
    "id",
    "date_status",
    "source_captures"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "date_label": {
      "type": "string"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "code",
        "name",
        "shortName"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shortName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "number",
        "title"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "transcription_policy": {
      "type": "string",
      "minLength": 1
    },
    "mapped_topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "topic_id",
          "label",
          "href"
        ],
        "properties": {
          "topic_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "href": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "page",
          "blocks"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "heading": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/block"
            }
          }
        }
      }
    },
    "source_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date_status": {
      "const": "undated"
    },
    "source_captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "$defs": {
    "figure": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "src",
        "alt"
      ],
      "properties": {
        "type": {
          "const": "figure"
        },
        "src": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string",
          "minLength": 8
        },
        "caption": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "textBlock": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "enum": [
            "line",
            "heading",
            "subheading",
            "paragraph",
            "bullet",
            "equation"
          ]
        },
        "text": {
          "type": "string"
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/figure"
        },
        {
          "$ref": "#/$defs/textBlock"
        },
        {
          "$ref": "#/$defs/accordions"
        },
        {
          "$ref": "#/$defs/pankusdeskTip"
        }
      ]
    },
    "accordions": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "accordions"
        },
        "label": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "paragraphs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "bullets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "question_paragraphs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "final_answer": {
                "type": "string"
              }
            },
            "anyOf": [
              {
                "required": [
                  "paragraphs"
                ]
              },
              {
                "required": [
                  "bullets"
                ]
              }
            ]
          }
        }
      }
    },
    "pankusdeskTip": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "title"
      ],
      "properties": {
        "type": {
          "const": "pankusdesk-tip"
        },
        "label": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bullets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "example": {
          "type": "string"
        }
      }
    }
  },
  "not": {
    "required": [
      "date"
    ]
  }
}
